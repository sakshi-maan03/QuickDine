{
    "name": "quickdine-server",
    "version": "1.0.0",
    "private": true,
    "description": "QuickDine REST API (Express + MongoDB + TypeScript)",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "typecheck": "tsc -p tsconfig.json",
        "seed": "tsx src/seed/seed.ts",
        "seed:reset": "tsx src/seed/seed.ts --reset",
        "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "mongoose": "^9.11.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.5",
        "tsx": "^4.23.15",
        "typescript": "~5.9"
    }
}
