# ──────────────────────────────────────────────────────────────
# QuickDine server configuration
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# The real ".env" file is git-ignored and must NEVER be committed.
# ──────────────────────────────────────────────────────────────

# --- Server ---
NODE_ENV=development
PORT=5000

# The address of your React app. Browsers are only allowed to call this API
# from here (CORS). Separate several origins with commas.
CLIENT_URL=http://localhost:5173

# --- MongoDB Atlas ---
# Atlas dashboard -> Connect -> Drivers -> copy the connection string.
# Replace <username>, <password> and add a database name (e.g. quickdine).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quickdine?retryWrites=true&w=majority

# --- Authentication (used from Step 2) ---
# Must be a long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Business rules ---
# Used to decide whether a booking slot is already in the past.
BUSINESS_TIMEZONE=Asia/Kolkata

# --- Cloudinary (used from Step 5 for restaurant photos) ---
# Cloudinary dashboard -> Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed script (npm run seed) ---
# Passwords for the demo accounts the seed script creates.
# Use strong values; the script refuses passwords shorter than 8 characters.
SEED_ADMIN_EMAIL=admin@quickdine.example
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_USER_PASSWORD=
